# Constrains the temporal RuleCompiler output. Adds `trigger` (appears / loiter
# / left_behind) and `dwell_s` (loiter seconds) to the flat rule schema, fixed
# order so it always parses. This is what lets plain English compile to the
# conditions a detector can't express.
root ::= "{\"subject\":" ws subject ",\"zone\":" ws zone ",\"trigger\":" ws trigger ",\"dwell_s\":" ws int ",\"start\":" ws time ",\"end\":" ws time ",\"cooldown_s\":" ws int "}"
subject ::= "\"person\"" | "\"vehicle\"" | "\"animal\"" | "\"package\""
trigger ::= "\"appears\"" | "\"loiter\"" | "\"left_behind\"" | "\"removed\""
zone ::= "\"" word "\""
word ::= [a-z]+
time ::= "\"" [0-2] [0-9] ":" [0-5] [0-9] "\""
int ::= [0-9]+
ws ::= [ ]*
